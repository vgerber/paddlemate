{
  "uid": "paddlemate-api-usage",
  "title": "Paddlemate API usage",
  "tags": [
    "paddlemate",
    "analytics"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "graphTooltip": 1,
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "clickhouse"
        },
        "query": "SELECT DISTINCT route FROM paddlemate.api_events WHERE $__timeFilter(ts) ORDER BY route",
        "definition": "SELECT DISTINCT route FROM paddlemate.api_events WHERE $__timeFilter(ts) ORDER BY route",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests over time by client",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "table",
          "rawSql": "SELECT $__timeInterval(ts) AS time, client, count() AS requests FROM paddlemate.api_events WHERE $__timeFilter(ts) AND route IN (${route:singlequote}) GROUP BY time, client ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests over time by route",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "table",
          "rawSql": "SELECT $__timeInterval(ts) AS time, route, count() AS requests FROM paddlemate.api_events WHERE $__timeFilter(ts) AND route IN (${route:singlequote}) GROUP BY time, route ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "table",
      "title": "Top routes",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT route, count() AS requests FROM paddlemate.api_events WHERE $__timeFilter(ts) GROUP BY route ORDER BY requests DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "piechart",
      "title": "Status mix",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 8,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT concat(toString(intDiv(status,100)),'xx') AS status_class, count() AS requests FROM paddlemate.api_events WHERE $__timeFilter(ts) GROUP BY status_class"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": true,
          "fields": ""
        }
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Most used features",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 14,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT transform(splitByChar('/', route)[4], ['users','groups','waterways','gauges','descents','materials','geo','proposals','trips','search','map','brands','water-status','regions','catalog'], ['Account and follows','Groups','Rivers and sections','Gauges','Logbook','Gear wiki','Map data','Proposals','Trips','Search','Map','Gear brands','Water status','Regions','Catalog'], splitByChar('/', route)[4]) AS feature, count() AS requests FROM paddlemate.api_events WHERE $__timeFilter(ts) AND route != 'unmatched' GROUP BY feature ORDER BY requests DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "Requests grouped by the first path segment after /api/v1 (users, waterways, gauges, ...) under readable names. Counts requests, not people."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latency p50 and p95 by route",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "table",
          "rawSql": "SELECT $__timeInterval(ts) AS time, route, quantile(0.5)(latency_ms) AS p50, quantile(0.95)(latency_ms) AS p95 FROM paddlemate.api_events WHERE $__timeFilter(ts) AND route IN (${route:singlequote}) GROUP BY time, route ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "table",
      "title": "Slowest routes (p95)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT route, count() AS requests, quantile(0.5)(latency_ms) AS p50_ms, quantile(0.95)(latency_ms) AS p95_ms FROM paddlemate.api_events WHERE $__timeFilter(ts) GROUP BY route HAVING requests >= 5 ORDER BY p95_ms DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "table",
      "title": "Error routes (4xx and 5xx)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT route, status, count() AS requests FROM paddlemate.api_events WHERE $__timeFilter(ts) AND status >= 400 GROUP BY route, status ORDER BY requests DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "type": "table",
      "title": "Filter usage (category, discipline, construction, sort)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT key, value, count() AS requests FROM paddlemate.api_events ARRAY JOIN mapKeys(query) AS key, mapValues(query) AS value WHERE $__timeFilter(ts) GROUP BY key, value ORDER BY requests DESC LIMIT 30"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "How often each closed-set filter value is used. Values outside the known list show as other."
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Hourly requests (rollup, 3 years)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "table",
          "rawSql": "SELECT hour AS time, status_class, sum(requests) AS requests FROM paddlemate.api_events_hourly WHERE hour >= toStartOfHour($__fromTime) AND hour <= $__toTime GROUP BY time, status_class ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
