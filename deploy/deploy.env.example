# Copy to deploy/deploy.env (git-ignored) and fill in: the deploy scripts read it.
NAS_USER=your-user
NAS_HOST=your-nas
# Folder that holds paddlemate-frontend/, paddlemate-backend/ and overpass/ on the NAS
NAS_ROOT=/volume1/shared_services
# The rsync module that maps to NAS_ROOT
NAS_MODULE_ROOT=shared_services
