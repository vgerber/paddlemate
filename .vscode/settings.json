{
  "chat.tools.terminal.autoApprove": {
    "mkdir": true,
    "cargo sqlx": true,
    "bun": true,
    "bunx": true,
    ".venv/bin/python3": true,
    ".venv/bin/python": true,
    "scripts/.venv/bin/python3": true,
    "cargo run": true,
    "./node_modules/.bin/biome": true,
    "docker exec": true
  },
  "cSpell.words": ["Rivermap"],

  // Cargo.toml lives in api/, not the repo root; pin it explicitly so
  // rust-analyzer doesn't fall back to analyzing .rs files with no project
  // context (which looks like errors on every line).
  "rust-analyzer.linkedProjects": ["api/Cargo.toml"],

  // Use the project-local Biome binary
  "biome.lsp.bin": "./frontend/node_modules/@biomejs/biome/bin/biome",

  // Biome as default formatter for JS/TS
  "[javascript]": { "editor.defaultFormatter": "biomejs.biome" },
  "[javascriptreact]": { "editor.defaultFormatter": "biomejs.biome" },
  "[typescript]": { "editor.defaultFormatter": "biomejs.biome" },
  "[typescriptreact]": { "editor.defaultFormatter": "biomejs.biome" },
  "[json]": { "editor.defaultFormatter": "biomejs.biome" },

  // Disable ESLint for the frontend (Biome replaces it)
  "eslint.workingDirectories": [],
  "eslint.enable": false
}
