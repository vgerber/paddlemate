{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "API: Run",
      "type": "shell",
      "command": "cargo run",
      "options": {
        "cwd": "${workspaceFolder}/api"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": "$rustc"
    },
    {
      "label": "DB: Init",
      "type": "shell",
      "command": "cargo sqlx database create && cargo sqlx migrate run",
      "options": {
        "cwd": "${workspaceFolder}/api"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "DB: Migrate",
      "type": "shell",
      "command": "cargo sqlx migrate run",
      "options": {
        "cwd": "${workspaceFolder}/api"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "DB: Update SQLx Cache",
      "type": "shell",
      "command": "cargo sqlx prepare",
      "options": {
        "cwd": "${workspaceFolder}/api"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "DB: Import Gauges",
      "type": "shell",
      "command": "scripts/.venv/bin/python scripts/import_gauges.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
