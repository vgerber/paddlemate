{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT u.id, u.username, u.created_at, u.updated_at\n        FROM users u\n        JOIN user_follows uf ON uf.follower_id = u.id\n        WHERE uf.following_id = $1 AND uf.status = 'pending'\n        ORDER BY uf.created_at\n        ",
