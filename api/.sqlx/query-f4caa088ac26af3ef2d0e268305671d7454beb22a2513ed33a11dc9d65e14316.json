{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT u.id, u.username, u.created_at, u.updated_at\n        FROM users u\n        JOIN user_follows uf ON uf.following_id = u.id\n        WHERE uf.follower_id = $1 AND uf.status = 'accepted'\n        ORDER BY u.username\n        ",
