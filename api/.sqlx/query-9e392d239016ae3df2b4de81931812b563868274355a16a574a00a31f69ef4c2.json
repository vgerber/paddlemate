{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT g.id, g.name, g.description, g.created_by, g.created_at, g.updated_at\n        FROM groups g\n        INNER JOIN group_members gm ON gm.group_id = g.id\n        WHERE gm.user_id = $1\n        ORDER BY g.name\n        ",
