{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT gm.group_id, gm.user_id, u.username, gm.role AS \"role: GroupMemberRole\",\n               gm.added_by, gm.created_at\n        FROM group_members gm\n        INNER JOIN users u ON u.id = gm.user_id\n        WHERE gm.group_id = $1\n        ORDER BY gm.created_at\n        ",
