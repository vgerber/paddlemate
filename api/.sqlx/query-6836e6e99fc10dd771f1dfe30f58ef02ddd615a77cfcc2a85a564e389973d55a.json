  "query": "\n        INSERT INTO feature_descriptions (feature_id, lang_code, description)\n        VALUES ($1, $2, $3)\n        ON CONFLICT (feature_id, lang_code) DO UPDATE SET description = EXCLUDED.description\n        RETURNING id, feature_id, lang_code, description\n        ",
