  "query": "\n        UPDATE waterways\n        SET\n            name = COALESCE($1, name),\n            description = COALESCE($2, description),\n            updated_at = NOW()\n        WHERE id = $3\n        RETURNING id, waterway_type AS \"waterway_type: WaterwayType\", name, description, created_at, updated_at\n        ",
