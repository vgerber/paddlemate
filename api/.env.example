# Database Configuration
# docker-compose.yml maps the database container to host port 6432
DATABASE_URL=postgresql://postgres:postgres@localhost:6432/paddlemate

# Keycloak Authentication Configuration
KEYCLOAK_URL=https://auth.example.com
KEYCLOAK_REALM=myrealm
KEYCLOAK_AUDIENCE=account
KEYCLOAK_TOKEN_URL=https://auth.example.com/realms/myrealm/protocol/openid-connect/token

# Keycloak Service Account (for admin API access)
KEYCLOAK_CLIENT_ID=your-client-id
KEYCLOAK_CLIENT_SECRET=your-client-secret

# Application Settings
PORT=3000
BASE_URL=/api/v1

# RUST_LOG=debug,axum_keycloak_auth=trace,tower_http=trace

# Set to true to skip background gauge polling (useful for local dev)
# DISABLE_GAUGE_READERS=true

# Per-caller request budget, defaults to 20/s. Keep it 0 on dev machines:
# the limiter's clock does not survive a laptop suspend and every caller
# gets 429s with absurd retry times until the process restarts.
RATE_LIMIT_PER_SECOND=0
